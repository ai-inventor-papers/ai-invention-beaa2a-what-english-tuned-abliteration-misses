\newlabel{tab:headline}{{1}{5}{Refusal rate and attack success rate (ASR) on RefusEU S5 harmful prompts ($n=280$ per cell), with 95\% Clopper--Pearson confidence intervals. Over-refusal is on S6 benign prompts ($n=150$). Edited English outputs are truncated at 256 tokens in 94--95\% of cases (see Method)}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Keyword Measurement Bias}{5}{subsection.4.2}\protected@file@percent }
\newlabel{sec:keyword-bias}{{4.2}{5}{Keyword Measurement Bias}{subsection.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Keyword counter vs.\ reference judge positive rates for the Gemma-edit checkpoint on 100 verified paired prompts. The keyword counter fires on 87\% of English responses but 0\% of Slovene responses; the reference judge finds 13\% English refusal and 82\% Slovene refusal. $\Delta _{\mathrm  {lang}} = -1.56$ [$-1.68$, $-1.44$]. The keyword counter is structurally blind to Slovene refusals.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:keyword-bias}{{2}{6}{Keyword counter vs.\ reference judge positive rates for the Gemma-edit checkpoint on 100 verified paired prompts. The keyword counter fires on 87\% of English responses but 0\% of Slovene responses; the reference judge finds 13\% English refusal and 82\% Slovene refusal. $\Delta _{\mathrm {lang}} = -1.56$ [$-1.68$, $-1.44$]. The keyword counter is structurally blind to Slovene refusals}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Keyword refusal counter vs.\ judge reference on held-out prompts. The keyword counter correctly identifies English refusals in unedited models (CONCORDANT) but produces zero positives on Slovene text (SILENT) and misfires on edited English text (MISFIRING, FP share 0.81).}}{6}{table.2}\protected@file@percent }
\newlabel{tab:keyword}{{2}{6}{Keyword refusal counter vs.\ judge reference on held-out prompts. The keyword counter correctly identifies English refusals in unedited models (CONCORDANT) but produces zero positives on Slovene text (SILENT) and misfires on edited English text (MISFIRING, FP share 0.81)}{table.2}{}}
