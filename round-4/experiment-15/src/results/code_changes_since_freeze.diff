+def gbf_pairtol(K, C, sigma, delta: float = DELTA) -> dict:
+    """EXPLORATORY, POST HOC (added after the first two-search analysis; not frozen): GBF with a PER-PAIR tolerance
+    tol_ij = sqrt(sigma_i^2 + sigma_j^2) instead of the frozen median-based sigma_bar*sqrt(2). The frozen tolerance is
+    dominated by candidates near the 100/100 ceiling, where the binomial SD vanishes, so it understates the objective's
+    noise exactly in the low-refusal region."""
+    K, C, s = (np.asarray(x, float) for x in (K, C, sigma))
+    iu = np.triu_indices(len(K), k=1)
+    dK = np.abs(K[:, None] - K[None, :])[iu]
+    dC = np.abs(C[:, None] - C[None, :])[iu]
+    tol = np.sqrt(s[:, None] ** 2 + s[None, :] ** 2)[iu]
+    den = dC >= delta
+    num = den & (dK <= tol)
+    return {"gbf": float(num.sum() / den.sum()) if den.sum() else float("nan"), "num": int(num.sum()), "den": int(den.sum())}
+
+
+def paired_difference_pairtol(Ka, Ca, Sa, Kb, Cb, Sb, B: int = B_DEFAULT, seed: int = 7, delta: float = DELTA) -> dict:
+    Ka, Ca, Sa, Kb, Cb, Sb = (np.asarray(x, float) for x in (Ka, Ca, Sa, Kb, Cb, Sb))
+    n = len(Ka)
+    point = gbf_pairtol(Ka, Ca, Sa, delta)["gbf"] - gbf_pairtol(Kb, Cb, Sb, delta)["gbf"]
+    rng = np.random.default_rng(seed)
+    d = []
+    for _ in range(B):
+        s = rng.integers(0, n, n)
+        v = gbf_pairtol(Ka[s], Ca[s], Sa[s], delta)["gbf"] - gbf_pairtol(Kb[s], Cb[s], Sb[s], delta)["gbf"]
+        if not np.isnan(v):
+            d.append(v)
+    d = np.asarray(d)
+    return {"diff": float(point), "ci95": [float(np.percentile(d, 2.5)), float(np.percentile(d, 97.5))],
+            "excludes_zero": bool(np.percentile(d, 2.5) > 0 or np.percentile(d, 97.5) < 0), "B_valid": int(len(d))}
 
 
